// SN Adobe Analytic — Prisma schema (Postgres / Supabase).
//
// PR #27: switched provider from `sqlite` to `postgresql` so the app can
// run on Supabase in production. The model shape is intentionally
// unchanged — every `*Json` column that previously worked around
// SQLite's lack of array support still stores JSON-encoded strings
// here. We keep them as `String` on purpose:
//
//   - Zero runtime code changes. Every call site that reads/writes
//     these columns (`src/lib/utils.ts:parseJsonArray`,
//     `src/lib/providers/manual-import.ts`,
//     `src/app/api/favorites/route.ts`, …) continues to work
//     unmodified, which keeps the blast radius of this migration
//     to "prisma provider swap + docs".
//   - Forward-compatible. A later PR can convert individual columns
//     to native `String[]` / `Json` one at a time; the JSON-string
//     encoding is already valid JSON so backfill is trivial.
//
// `directUrl` is used by `prisma migrate` / `prisma db push` (DDL).
// `url` is used by the app at request time. On Supabase:
//   - `url`        -> pooled connection (port 6543, pgBouncer)
//   - `directUrl`  -> direct connection (port 5432)
// See docs/DEPLOYMENT.md for the exact format.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String    @unique
  emailVerified     DateTime?
  hashedPassword    String?
  image             String?
  plan              String    @default("FREE") // FREE | STARTER | PRO | ANNUAL
  // Access-control role. Kept as a string (not a Prisma enum) for
  // historical + forward-compat reasons: (a) the original SQLite
  // schema couldn't use enums cleanly, so every call site already
  // handles string input, and (b) PR #27 deliberately kept the
  // column shape unchanged when switching providers to Postgres so
  // the migration could be a pure provider swap. `normalizeRole()`
  // maps any unknown value back to "USER" so a typo or stale value
  // never silently grants elevated access. Valid values:
  // "USER" | "OWNER" | "ADMIN".
  //
  // IMPORTANT: this field is written ONLY by server-side code (the
  // owner-bootstrap helper during sign-in, or an ops user editing the
  // DB directly). There is no public endpoint that lets a signed-in
  // user change their own role, and no API route accepts `role` in a
  // request body. See `src/lib/owner-bootstrap.ts`.
  role              String    @default("USER")
  // First time we promoted this user out of the default USER role.
  // Never overwritten on subsequent bootstraps — lets the Settings
  // page show "Owner since <date>" honestly instead of jumping every
  // time the user re-signs-in.
  ownerAccessGrantedAt DateTime?
  // How the user got their elevated role. Today the only automatic
  // source is "env_bootstrap" (matched OWNER_EMAILS on login). Reserved
  // strings: "env_bootstrap" | "manual" | "seed". `null` while role is
  // "USER"; cleared if role is ever reset back to "USER".
  ownerAccessSource String?
  searchesUsedToday Int       @default(0)
  searchResetAt     DateTime  @default(now())
  // Which imported dataset powers this user's Search/Dashboard/Portfolio/
  // Heat Map/Trending/Export views.
  //
  // Semantics:
  //   null              -> "all datasets" (aggregate across every
  //                        non-archived dataset the user owns). This is
  //                        the default for a fresh account and the state
  //                        we fall back to if the id below becomes
  //                        orphaned (archived/deleted/other user).
  //   "__demo__"        -> explicit opt-in to the mock provider even when
  //                        the user has imported datasets.
  //   <datasetId>       -> scope all queries to that single dataset. We
  //                        re-verify ownership + archived=false on every
  //                        read. If the check fails we silently fall back
  //                        to "all datasets" and clear this field so the
  //                        user doesn't get stuck on a ghost dataset.
  //
  // NOT a foreign key on purpose — we want the column to keep its string
  // value even if the referenced dataset is hard-deleted, and we don't
  // want a cascade to wipe the user row.
  activeDatasetId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  devices   Device[]
  searches  SearchHistory[]
  favorites Favorite[]
  exports   ExportHistory[]
  importedDatasets ImportedDataset[]
  collections      Collection[]
  savedSearches    SavedSearch[]
  passwordResetTokens PasswordResetToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Device {
  id         String   @id @default(cuid())
  userId     String
  deviceName String
  // Client-generated opaque id. Stored in the `sn-device-id` cookie so the
  // same browser-profile is recognized as one device across tabs + across
  // re-logins. Unique per row; collisions are avoided at insert time by
  // upserting on (userId, deviceId) which the API layer enforces.
  deviceId   String   @unique
  // User-agent fingerprint (first ~200 chars of the UA header). Best-effort
  // only — never used as a security signal, only as a human-readable
  // "Chrome on macOS" label on the device-management page.
  userAgent  String?
  // Rough geolocation hint, if available from the reverse proxy / CDN
  // headers. Same caveat as `userAgent`: display-only.
  ipHint     String?
  lastActive DateTime @default(now())
  firstSeen  DateTime @default(now())
  // Soft-revoke flag. Flipping this to false does not currently terminate
  // an in-flight session (PR #16 is foundation only) but it's the hook a
  // future hard-enforce PR will read to reject further requests.
  isActive   Boolean  @default(true)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([userId, lastActive])
}

/// One-time password-reset token. We never store the raw token — only a
/// bcrypt hash of it — and we never log the raw token either. The plaintext
/// is handed back to the user exactly once, embedded in the reset URL sent
/// to their email (or, in local dev, returned in the JSON response so the
/// developer can click through without configuring a mailer).
///
/// Lookup is by hash comparison over all non-used, non-expired rows for the
/// target user; this keeps the common case fast (most users have zero or
/// one pending token) and dodges the "search by plaintext" pattern that
/// some naive implementations fall into.
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  // bcrypt(token). Lookups scan userId + non-expired + non-used rows and
  // `bcrypt.compare` the presented plaintext against each candidate.
  tokenHash  String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model SearchHistory {
  id          String   @id @default(cuid())
  userId      String
  keyword     String
  sort        String   @default("relevance")
  contentType String   @default("all")
  aiFilter    String   @default("all")
  resultCount Int?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Favorite {
  id               String   @id @default(cuid())
  userId           String
  assetId          String
  thumbnailUrl     String
  title            String
  // `downloads` / `performanceScore` are the SAVED-AT SNAPSHOT. They never
  // change after the initial save — they're the baseline the UI diffs
  // against when computing `deltaDownloads` / `deltaPerformanceScore`.
  // Rename happened implicitly at PR #15 — schema kept for compatibility
  // with rows persisted in PR #1..#14.
  downloads        Int
  performanceScore Int
  contributorName  String?
  keywordsJson     String   @default("[]") // JSON-encoded string[]
  savedAt          DateTime @default(now())
  // Free-text user notes. Optional; capped at ~2KB by the API layer.
  notes            String?
  // Collection/folder assignment. Nullable (= "Uncategorized"). Kept as
  // a non-cascading relation on purpose: if a Collection is deleted we
  // want favorites to fall back to Uncategorized, not to be deleted.
  // Enforced via `SetNull` below.
  collectionId     String?
  collection       Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  // Track-changes telemetry. The UI uses these to render the delta card.
  // `lastCheckedAt == null` means "tracking has not been attempted yet"
  // and we render "Not yet checked" instead of a fabricated +0 delta.
  // `lastCheckedDownloads == null` after a refresh means the active
  // provider couldn't supply a verified current figure — we render
  // "Unavailable" on the delta card rather than faking a zero.
  lastCheckedAt             DateTime?
  lastCheckedDownloads      Int?
  lastCheckedPerformanceScore Int?
  // Data-quality tier of the most recent refresh (demo | estimated |
  // public_metadata | verified). Stored as a string for
  // forward-compatibility with the rest of the schema (see
  // User.role on why we don't use Prisma enums here).
  lastCheckedDataQuality    String?
  lastCheckedProviderId     String?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, assetId])
  @@index([userId, collectionId])
}

/// User-defined folder for organizing saved assets and saved searches.
/// Users can create as many as they want. Deleting a collection moves its
/// contained items back to "Uncategorized" (SetNull) rather than cascading
/// — we never want a misclick to wipe the user's saved library.
model Collection {
  id          String   @id @default(cuid())
  userId      String
  name        String
  // Optional short description shown under the collection name.
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  favorites   Favorite[]
  searches    SavedSearch[]

  // Case-sensitive uniqueness per-user. The API layer lowercases the
  // display name before comparing to keep "Travel" and "travel" from
  // colliding in practice while preserving the user's casing for display.
  @@unique([userId, name])
  @@index([userId])
}

/// User-saved search query + filter set. Separate from SearchHistory —
/// history is transient, SavedSearch is pinned by the user. Carries the
/// resolved provider + data-quality at save time so the UI can label the
/// row honestly even if the user later switches providers.
///
/// Dataset scope is snapshotted as a string tag (same shape as
/// ExportHistory) so a later archive/rename of the underlying dataset
/// doesn't break the saved row.
model SavedSearch {
  id           String   @id @default(cuid())
  userId       String
  name         String?  // User-editable display label; defaults to the keyword
  keyword      String
  sort         String   @default("relevance")
  contentType  String   @default("all")
  aiFilter     String   @default("all")
  resultCount  Int?
  // Quality + provider snapshot at save time. Matches ExportHistory's
  // shape so the UI can reuse the same badges.
  dataQuality  String   @default("demo")
  providerName String   @default("Mock data provider")
  providerId   String?
  // Dataset scope at save time. See ExportHistory.datasetScope for why
  // we keep this as a string tag + nullable non-FK dataset id.
  datasetScope String   @default("demo_data")
  datasetId    String?
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, collectionId])
}

/// Cache layer for the public-metadata provider (PR #22).
///
/// The public metadata provider pulls search metadata off publicly
/// visible Adobe Stock pages (via the allow-listed HTTP scraper OR a
/// configured first-party endpoint). Hitting Adobe Stock on every
/// request would be wasteful + abusive; this table gives us a
/// cache-first read path.
///
/// Shape notes:
///   - `source` distinguishes rows produced by different upstreams
///     ("public_scrape" from our Axios + Cheerio scraper,
///      "official_api" from a configured HTTP boundary). Two providers
///     can coexist without clobbering each other.
///   - `payloadJson` holds the exact `ProviderSearchResult` envelope
///     the UI consumes. Cache hits are one SELECT + one JSON.parse —
///     no joins, no hydration.
///   - `expiresAt` is an absolute timestamp. Reads compare against
///     `now()` and treat past rows as stale (served as cache miss but
///     kept around as a graceful-fallback source if the live fetch
///     fails or is blocked). Per PR #22 brief, stale-but-present
///     beats empty when the live fetch can't complete.
///   - `fetchedAt` is retained for observability (how old is this
///     payload?) and is independent of `expiresAt` so we can change
///     TTL without rewriting rows.
///
/// Old shape (pre-PR #22) had per-field columns + a foreign-key link to
/// CachedAsset; no code ever read it. Replaced with the
/// single-payload model because (a) the provider envelope changes over
/// time and we don't want a schema migration every time, (b) the
/// public scraper may not have every PRD field — forcing NOT NULL
/// columns would push us to fake values we don't have.
model CachedSearch {
  id          String   @id @default(cuid())
  source      String   @default("public_scrape")
  keyword     String
  sort        String   @default("relevance")
  contentType String   @default("all")
  aiFilter    String   @default("all")
  page        Int      @default(1)
  payloadJson String
  fetchedAt   DateTime @default(now())
  expiresAt   DateTime

  @@unique([source, keyword, sort, contentType, aiFilter, page])
  @@index([expiresAt])
}

/// Cache layer for an individual asset's public metadata. Reserved
/// for the asset-detail drilldown path (PRD §5.1 "full title,
/// keywords, upload date, contributor, content type, premium status").
/// TTL is longer than CachedSearch because detail pages change much
/// more slowly than search results. `payloadJson` carries the same
/// `SearchAsset` shape the provider emits, so downstream code treats
/// it identically to a live response.
model CachedAsset {
  id          String   @id @default(cuid())
  source      String   @default("public_scrape")
  assetId     String
  payloadJson String
  fetchedAt   DateTime @default(now())
  expiresAt   DateTime

  @@unique([source, assetId])
  @@index([expiresAt])
}

/// Cache layer for a contributor's public metadata (PR #24).
///
/// Stores the parsed public contributor page payload so repeat
/// portfolio lookups don't re-fetch Adobe Stock. Keyed by
/// (source × contributorId). TTL ~7d (contributor pages change
/// infrequently). Same freshness policy as CachedAsset: stale rows
/// are returned as fallback when live fetch fails.
model CachedContributor {
  id              String   @id @default(cuid())
  source          String   @default("public_scrape")
  contributorId   String
  payloadJson     String
  fetchedAt       DateTime @default(now())
  expiresAt       DateTime

  @@unique([source, contributorId])
  @@index([expiresAt])
}

model ExportHistory {
  id           String   @id @default(cuid())
  userId       String
  type         String // "search" | "portfolio" | "saved" | "imported" | "heatmap" | "trending"
  query        String // search keyword, contributor query, dataset name, etc.
  rowCount     Int
  dataQuality  String   @default("demo") // "demo" | "estimated" | "public_metadata" | "verified"
  providerName String   @default("Mock data provider")
  // Dataset scope snapshot at export time. Lets the history row survive
  // a later archive/delete — the audit entry stays accurate.
  // Values: "all_datasets" | "selected_dataset" | "demo_data".
  datasetScope String   @default("demo_data")
  // Non-FK pointer (ImportedDataset might be deleted later); only set when
  // datasetScope = "selected_dataset". See User.activeDatasetId for why
  // we deliberately avoid a cascading FK.
  datasetId    String?
  fileUrl      String?
  paramsJson   String   @default("{}") // serialized request payload to support "download again"
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// User-uploaded analytics (CSV / JSON). Each row in `ImportedAsset` represents
// one asset the user owns. Multiple datasets per user are supported — when the
// manualImportProvider serves a query it aggregates across all of a user's
// non-archived datasets.
model ImportedDataset {
  id          String   @id @default(cuid())
  userId      String
  name        String
  // Original filename the user uploaded (e.g. "q3-2025-adobe.csv"). Shown
  // on the /import management table so the user can tell two identically
  // named datasets apart. Optional because old rows predate this column.
  originalFileName String?
  source      String   @default("csv") // "csv" | "json"
  rowCount    Int      @default(0)
  // Rows that the importer couldn't normalize (bad numbers, bad dates, etc).
  // The import still succeeds — we just record how many rows were dropped
  // so the user can see `rowCount` valid / `skippedRowCount` skipped.
  skippedRowCount Int  @default(0)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets      ImportedAsset[]

  @@index([userId, createdAt])
}

model ImportedAsset {
  id                  String   @id @default(cuid())
  datasetId           String
  // Original asset identifiers from the user's export (best-effort; we
  // keep them as strings to avoid clashing with our cuid `id`).
  externalId          String?
  // Core fields. Anything the user did NOT supply is left null and we
  // surface it as "unknown" in the UI rather than fabricating a value.
  title               String?
  thumbnailUrl        String?
  downloads           Int?
  performanceScore    Int?     // user-provided score; if absent, app may compute an estimated one
  downloadsPerMonth   Float?
  contentType         String?
  categoriesJson      String   @default("[]") // JSON-encoded String[]
  uploadDate          DateTime?
  contributorName     String?
  contributorId       String?
  // Optional contributor page URL (PR #29). Plumbed through from the
  // user's CSV `contributorUrl` / `contributorprofileurl` column when
  // present. Read at render time by `resolveContributorLink` (see
  // `src/lib/adobe-stock-link.ts`) and used in preference to
  // synthesizing `/uk/contributor/<id>` — the user may have pasted a
  // real profile URL that doesn't match our synthesized shape (e.g.
  // a locale other than `/uk/`, or a legacy `/artist/<id>` path). A
  // non-`stock.adobe.com` URL in this column is ignored at render
  // time; we never trust this field to point at a third-party origin.
  contributorUrl      String?
  isPremium           Boolean  @default(false)
  isAiGenerated       Boolean  @default(false)
  keywordsJson        String   @default("[]") // JSON-encoded String[]
  adobeStockUrl       String?
  // Per-field provenance stored as JSON map (field -> "verified" | "estimated").
  // Anything not present in this map defaults to the dataset-level quality.
  fieldQualityJson    String   @default("{}")
  createdAt           DateTime @default(now())
  dataset             ImportedDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
  @@index([contributorName])
}
