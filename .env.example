# --------------------------------------------------------------------
# Database (Postgres — Supabase in production, local Postgres in dev)
# --------------------------------------------------------------------
# As of PR #27 the Prisma schema targets PostgreSQL. SQLite is no
# longer supported. See docs/DEPLOYMENT.md for the full setup guide.
#
# DATABASE_URL  — used by the app at request time. On Supabase this
#                 is the POOLED (pgBouncer) connection on port 6543
#                 with `?pgbouncer=true&connection_limit=1`.
# DIRECT_URL    — used by `prisma migrate` / `prisma db push` (DDL).
#                 On Supabase this is the DIRECT connection on port
#                 5432. Optional locally (defaults to DATABASE_URL).
#
# Local dev options:
#   (a) Run a local Postgres (`brew services start postgresql`,
#       Docker, Postgres.app, etc.) and point both URLs at it:
#         DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sn_adobe_analytic?schema=public"
#         DIRECT_URL="postgresql://postgres:postgres@localhost:5432/sn_adobe_analytic?schema=public"
#   (b) Point both URLs at a free Supabase project (safest if you
#       don't want to install Postgres locally).
#
# Production (Vercel + Supabase) — see docs/DEPLOYMENT.md:
#   DATABASE_URL="postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#   DIRECT_URL="postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres"
#
# NEVER commit real credentials. The lines below are placeholders only.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sn_adobe_analytic?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/sn_adobe_analytic?schema=public"

# --------------------------------------------------------------------
# NextAuth.js
# --------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# Google OAuth (optional — leave blank to disable Google sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Flip the client-visible flag to "1" in lockstep with setting the two
# vars above. The sign-in page uses this to decide whether to render the
# Google button enabled or disabled + greyed out. Leaving it unset keeps
# the button visible but disabled, with a tooltip explaining the
# deployment hasn't configured Google.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=""

# --------------------------------------------------------------------
# Owner / whitelist access (PRD §7, PR #18 bootstrap)
# --------------------------------------------------------------------
# Comma-separated list of email addresses that bootstrap the OWNER role
# into the database on sign-in / register. Intended for the operator's
# own account(s) and early admin users — NOT a customer-facing plan.
#
# Bootstrap semantics (as of PR #18):
#   - On every successful sign-in / register, if the session email
#     matches this list, the app promotes `User.role` from "USER" to
#     "OWNER" and stamps `ownerAccessGrantedAt` + `ownerAccessSource =
#     "env_bootstrap"`.
#   - The role PERSISTS in the database. Removing an email from
#     OWNER_EMAILS after the fact will NOT revoke the existing
#     OWNER/ADMIN role — that's deliberate so a typo in the env var
#     can't lock the operator out. To revoke, edit the user row
#     directly (see README "Owner / admin access").
#   - "ADMIN" is NEVER auto-granted from this env var. It's reserved
#     for out-of-band DB edits.
#
# Rules:
#   - Server-side ONLY. Never prefix with NEXT_PUBLIC_ and never ship
#     the list to the client. The client sees a single boolean
#     "is the signed-in caller an owner?" via /api/user/entitlements.
#   - Case-insensitive match against the verified NextAuth session email.
#   - Do NOT commit real emails to git. Placeholder only in this file;
#     set actual values in your Vercel/host env or local .env.
#   - Empty / unset => nobody is bootstrapped (existing DB roles still
#     apply; the app works normally).
#
# Example:
#   OWNER_EMAILS="owner@example.com,admin@example.com"
OWNER_EMAILS=""

# --------------------------------------------------------------------
# Data provider selection
# --------------------------------------------------------------------
# Which data source to read from. Options:
#   - "mock":     synthetic demo data (default; safe for any env)
#   - "manual":   user-uploaded CSV imports (auto-promoted from "mock"
#                 the moment a signed-in user has at least one dataset)
#   - "official": public-metadata / first-party source. Supports an
#                 HTTP boundary (OFFICIAL_PROVIDER_BASE_URL) AND the
#                 built-in public Adobe Stock scraper added in PR #22
#                 (PUBLIC_SCRAPER_ENABLED). Until ONE is configured
#                 the provider returns empty results with a clear
#                 "not configured" notice.
#   - "public":   alias for "official" — preferred spelling added
#                 alongside the PR #22 public-metadata scraper.
DATA_PROVIDER="mock"

# --------------------------------------------------------------------
# Public-metadata provider — HTTP boundary (optional)
# --------------------------------------------------------------------
# Base URL of the HTTP endpoint that fronts your authorized public-
# metadata or first-party source. The provider sends:
#   GET ${OFFICIAL_PROVIDER_BASE_URL}/search?keyword=...&page=...
#   GET ${OFFICIAL_PROVIDER_BASE_URL}/contributor?query=...
# See docs/PRD-ALIGNMENT.md for the expected response shapes.
#
# Until set, the provider falls through to the public Adobe Stock
# scraper (when PUBLIC_SCRAPER_ENABLED=true) or returns an empty
# response with a "not configured" notice.
OFFICIAL_PROVIDER_BASE_URL=""

# Optional bearer token. Sent as "Authorization: Bearer <key>" on
# every request to OFFICIAL_PROVIDER_BASE_URL. Leave blank for
# unauthenticated endpoints.
OFFICIAL_PROVIDER_API_KEY=""

# --------------------------------------------------------------------
# Public Adobe Stock scraper (PR #22)
# --------------------------------------------------------------------
# Opt-in switch for the built-in public-metadata scraper. When ON:
#   - The official provider reads public Adobe Stock search HTML
#     directly (no HTTP boundary required).
#   - Traffic is rate-limited (1 req/s per process), has a 10s
#     timeout, and retries at most once on transient failures.
#   - User-Agent is a static identifier ("SN-Adobe-Analytic/1.0").
#     No UA evasion, no proxy rotation, no captcha / anti-bot
#     bypass, no logged-in endpoints.
#   - Only metadata available on the public page is collected:
#     asset id, thumbnail, title, Adobe Stock URL, contributor
#     name/URL when visible, content type, keywords when present.
#     Download counts and performance scores are NOT available
#     from public pages and are labeled "Unavailable" in the UI.
#   - Results are cached in the CachedSearch / CachedAsset tables
#     with a ~24h TTL for search results and ~7d for asset
#     details. Cache-first reads avoid round-tripping Adobe on
#     every request.
PUBLIC_SCRAPER_ENABLED="false"

# Extra guardrail for production. Even if PUBLIC_SCRAPER_ENABLED=true,
# the scraper refuses to make network requests in NODE_ENV=production
# unless this is ALSO set. Deliberate double opt-in — we don't want a
# dev-only flag accidentally enabling scraping on a deployed instance.
PUBLIC_SCRAPER_ALLOW_PROD="false"

# Max size (in MB) of a single CSV upload to /api/import. Default: 10.
# Hard-capped at 100 in src/lib/env.ts regardless of what you set here.
# The `/import` UI uses a matching 10MB soft limit; raise this for server
# tolerance without needing a frontend redeploy.
MAX_IMPORT_FILE_SIZE_MB="10"

# Legacy alias. Pre-PR #22 setups used USE_LIVE_SCRAPER=true to
# indicate interest in live data; PUBLIC_SCRAPER_ENABLED now drives
# the actual public-metadata scraper. USE_LIVE_SCRAPER=true is still
# honored as a fallback opt-in for back-compat; prefer the new flag.
USE_LIVE_SCRAPER="false"

# --------------------------------------------------------------------
# Stripe (PR #26 — Payment Integration)
# --------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Stripe Price IDs per plan × currency. Create these in your Stripe
# dashboard (Products → Prices). Each plan needs a Price ID for every
# currency you want to support at checkout. If a Price ID is missing,
# the checkout button shows "not configured" instead of faking payment.
#
# USD prices:
STRIPE_STARTER_PRICE_ID_USD=""
STRIPE_PRO_PRICE_ID_USD=""
STRIPE_ANNUAL_PRICE_ID_USD=""
#
# IDR prices (create separate Stripe Prices in IDR currency):
STRIPE_STARTER_PRICE_ID_IDR=""
STRIPE_PRO_PRICE_ID_IDR=""
STRIPE_ANNUAL_PRICE_ID_IDR=""

# --------------------------------------------------------------------
# Currency display (PR #26)
# --------------------------------------------------------------------
# Static USD → IDR exchange rate used for DISPLAY ONLY on the /pricing
# page. This is NOT a live financial quote and is NOT used for actual
# checkout (Stripe uses the Price ID's configured currency). If unset,
# defaults to 16000 for local/demo display.
#
# To update: check the approximate rate and set this value. The IDR
# price shown to users is rounded to the nearest Rp1.000.
NEXT_PUBLIC_USD_TO_IDR_RATE="16000"

# --------------------------------------------------------------------
# PayPal (Phase 4 — optional)
# --------------------------------------------------------------------
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# --------------------------------------------------------------------
# Supabase (optional — only if you want to call Supabase client APIs
# directly from this app, e.g. for Storage or Row Level Security).
# --------------------------------------------------------------------
# Prisma reads Postgres via DATABASE_URL / DIRECT_URL above and does
# NOT need these. Leave them blank unless you're wiring Supabase's
# JS client (e.g. `@supabase/supabase-js`) into the app.
#
# NEXT_PUBLIC_SUPABASE_URL     — https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY — the anon/public API key
# SUPABASE_SERVICE_ROLE_KEY    — server-only key; NEVER prefix with
#                                NEXT_PUBLIC_ and never ship to the
#                                client.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
