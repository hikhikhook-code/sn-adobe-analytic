# --------------------------------------------------------------------
# Database
# --------------------------------------------------------------------
# Local dev: SQLite file. (`prisma/schema.prisma` is configured for sqlite.)
DATABASE_URL="file:./dev.db"
# Production / Vercel: switch the provider to "postgresql" in
# prisma/schema.prisma and point DATABASE_URL at your Supabase pooled
# connection string. See README "Vercel Deployment".

# --------------------------------------------------------------------
# NextAuth.js
# --------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# Google OAuth (optional — leave blank to disable Google sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --------------------------------------------------------------------
# Data provider selection
# --------------------------------------------------------------------
# Which data source to read from. Options:
#   - "mock":     synthetic demo data (default; safe for any env)
#   - "manual":   user-uploaded CSV imports (auto-promoted from "mock"
#                 the moment a signed-in user has at least one dataset)
#   - "official": public-metadata / first-party source. Requires
#                 OFFICIAL_PROVIDER_BASE_URL to be set; until then it
#                 returns empty results with a "not configured" notice.
DATA_PROVIDER="mock"

# --------------------------------------------------------------------
# Official / public-metadata provider (optional)
# --------------------------------------------------------------------
# Base URL of the HTTP endpoint that fronts your authorized public-
# metadata or first-party source. The provider sends:
#   GET ${OFFICIAL_PROVIDER_BASE_URL}/search?keyword=...&page=...
#   GET ${OFFICIAL_PROVIDER_BASE_URL}/contributor?query=...
# See docs/PRD-ALIGNMENT.md for the expected response shapes.
#
# Until set, the official provider returns empty results and the UI
# surfaces a "Public-metadata source not configured" notice.
OFFICIAL_PROVIDER_BASE_URL=""

# Optional bearer token. Sent as "Authorization: Bearer <key>" on
# every request to OFFICIAL_PROVIDER_BASE_URL. Leave blank for
# unauthenticated endpoints.
OFFICIAL_PROVIDER_API_KEY=""

# Max size (in MB) of a single CSV upload to /api/import. Default: 10.
# Hard-capped at 100 in src/lib/env.ts regardless of what you set here.
# The `/import` UI uses a matching 10MB soft limit; raise this for server
# tolerance without needing a frontend redeploy.
MAX_IMPORT_FILE_SIZE_MB="10"

# Live Adobe Stock scraping is INTENTIONALLY NOT IMPLEMENTED.
# This flag exists only to keep the surface area documented; setting it
# to "true" warns and continues to return mock data. In production it is
# always ignored.
USE_LIVE_SCRAPER="false"

# --------------------------------------------------------------------
# Stripe (Phase 4 — optional)
# --------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --------------------------------------------------------------------
# PayPal (Phase 4 — optional)
# --------------------------------------------------------------------
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# --------------------------------------------------------------------
# Supabase (only when migrating from SQLite to Postgres)
# --------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
