# Database (SQLite for local dev — switch provider to "postgresql" in
# prisma/schema.prisma + use a Supabase URL for production)
DATABASE_URL="file:./dev.db"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# Google OAuth (optional — leave blank to disable Google sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe (Phase 4 — optional)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# PayPal (Phase 4 — optional)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# Supabase (only needed when migrating from SQLite to Postgres)
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Scraping (Phase 2 — optional, scraper currently uses mock data)
PROXY_URL=""
SCRAPE_RATE_LIMIT_MS=1000

# Set to "true" to use the live Adobe Stock scraper instead of mock data
USE_LIVE_SCRAPER="false"
